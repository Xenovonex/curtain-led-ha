# Copy to /etc/curtain-led.env and fill in.
CURTAIN_ADDR=AA:BB:CC:DD:EE:FF   # your light's BLE address
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=curtain
MQTT_PASS=change-me
CURTAIN_NODE=curtain
CURTAIN_LOG_DIR=/home/pi/curtain-ble-logs   # where "Record BLE log" writes captures
CURTAIN_RECORD_MINUTES=20                    # recording auto-stop
# Sound-reactive (mic) mode: ALSA capture device the bridge reads to stream the
# e2 0a spectrum. Empty = feature disabled. Use a dsnoop PCM if the mic is shared
# (e.g. with a Wyoming voice satellite). See docs/PROTOCOL.md.
CURTAIN_MIC_PCM=                             # e.g. dsnoop_mic  (empty = off)
CURTAIN_MIC_RATE=48000                       # must match the capture device's native rate
DRAW_PORT=8095
GRID_W=20
GRID_H=20
